{
  "name": "example-fullstack",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "oxlint src",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed-authors.ts && tsx src/lib/db/seed-books.ts",
    "preview:cloudflare": "CLOUDFLARE=1 vite build && npx --yes wrangler@4.132.0 dev",
    "deploy:cloudflare": "CLOUDFLARE=1 vite build && npx --yes wrangler@4.132.0 deploy"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.6",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.39",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.5.0",
    "eslint-plugin-solid": "~0.18.0",
    "filesystem-routing": "0.2.1",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@neon/config": "^1.3.1",
    "@neon/env": "^1.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^11.1.0",
    "@remix-run/cookie": "^0.5.4",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.21",
    "@solidjs/web": "^2.0.0-rc.6",
    "@vercel/functions": "^3.9.8",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nitro": "3.0.260903-beta",
    "postgres": "^3.4.9",
    "solid-js": "^2.0.0-rc.6",
    "thumbhash": "^0.1.1",
    "valibot": "^1.4.2"
  },
  "packageManager": "pnpm@11.24.0"
}
